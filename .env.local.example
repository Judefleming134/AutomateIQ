# Copy to .env.local and fill in real values for local development.
# Never commit .env.local — it's gitignored. See README.md's Environment
# Variables table for what each of these is for.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=AutomateIQ <hello@automateiq.ie>

NEXT_PUBLIC_SITE_URL=http://localhost:3000

CRON_SECRET=pick-any-long-random-value
SETUP_SECRET=pick-any-long-random-value
